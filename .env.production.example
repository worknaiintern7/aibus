# ============================================
# Production Environment Variables for AI Bus
# ============================================

# Database Configuration (Postgres Container)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=aibus_db
DB_USER=postgres
DB_PASSWORD=ChangeThisToAStrongSecretPassword123!

# AI Bus Third-Party Provider Credentials
AIBUS_AUTH_URL=https://partnerapi.iamgds.com/ota/v1/Auth
AIBUS_CLIENT_ID=your-mantis-client-id
AIBUS_CLIENT_SECRET=your-mantis-client-secret

# Allowed CORS Origins (Comma separated URLs)
# Example: https://yourdomain.com,https://www.yourdomain.com,https://admin.yourdomain.com,https://agent.yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://admin.yourdomain.com,https://agent.yourdomain.com

# Frontend Build Arguments (Used when building Docker images)
# For Subdomain setup:
VITE_CUSTOMER_API_BASE_URL=https://api.yourdomain.com
VITE_ADMIN_API_BASE_URL=https://api.yourdomain.com
VITE_AGENT_API_BASE_URL=https://api.yourdomain.com

# Agent portal (separate app, container port 3002) and the customer site it links back to
VITE_AGENT_PORTAL_URL=https://agent.yourdomain.com
VITE_CUSTOMER_APP_URL=https://yourdomain.com

# For Single Domain setup:
# VITE_CUSTOMER_API_BASE_URL=https://yourdomain.com/api
# VITE_ADMIN_API_BASE_URL=https://yourdomain.com/api
